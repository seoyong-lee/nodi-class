{
  "name": "nodi-class",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nodi/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "infra:diff": "pnpm --filter @nodi/infra cdk diff",
    "infra:deploy": "pnpm --filter @nodi/infra cdk deploy --all",
    "infra:destroy": "pnpm --filter @nodi/infra cdk destroy --all",
    "report": "tsx scripts/report.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@vanilla-extract/css": "^1.21.2",
    "eslint": "^9.21.0",
    "eslint-plugin-nodi": "workspace:*",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
